# Development secret only; replace for any deployed environment.
DJANGO_SECRET_KEY=change-this-development-key
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
# Leave blank for local SQLite. Paste your Neon PostgreSQL connection string here.
DATABASE_URL=
# React Vite dev server
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
